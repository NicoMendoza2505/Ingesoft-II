    {
      "name": "GET Superhero Biography (Thor) with TOKEN XD",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "})",
              "",
              "pm.test('Response time is less than 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "})",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "})",
              "",
              "pm.test('Biography has full-name field', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('full-name');",
              "})",
              "",
              "pm.test('Biography has publisher field', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('publisher');",
              "})",
              "",
              "pm.test('Biography has place-of-birth field', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('place-of-birth');",
              "})",
              "",
              "pm.test('Name is Thor Odinson', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData['full-name']).to.equal('Thor Odinson');",
              "",
              "})",
              "",
              "pm.test(\"Token exist\", function () {",
              "    const token = pm.collectionVariables.get(\"token\");",
              "    pm.expect(token).to.exist;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url_superheroes}}/{{token}}/659/biography",
          "host": [
            "{{base_url_superheroes}}"
          ],
          "path": [
            "{{token}}",
            "659",
            "biography"
          ]
        },
        "description": "Obtiene solo la biografía del superhéroe con ID 659 (Thor). Endpoint: /api/{token}/{id}/biography"
      },
      "response": []
    },
    {
      "name": "POST Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "\r",
              "pm.collectionVariables.set(\"tokenjwt\", body.token);\r",
              "pm.collectionVariables.set(\"reftokenjwt\", body.refreshToken);\r",
              "\r",
              "pm.test(\"Status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Token existe\", function () {\r",
              "    pm.expect(body).to.have.property(\"token\");\r",
              "});\r",
              "\r",
              "pm.test(\"Usuario correcto\", function () {\r",
              "    pm.expect(body.username).to.eql(\"emilys\");\r",
              "});"
