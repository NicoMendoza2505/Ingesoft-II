  "item": [
    {
      "name": "Query - All Countries",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has countries array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property(\"countries\");",
              "    pm.expect(jsonData.data.countries).to.be.an(\"array\");",
              "});",
              "pm.test(\"Each country has code and name\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.data.countries.forEach(function(country) {",
              "        pm.expect(country).to.have.property(\"code\");",
              "        pm.expect(country).to.have.property(\"name\");",
              "    });",
              "});",
              "pm.test(\"No GraphQL errors\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.not.have.property(\"errors\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetAllCountries {\n  countries {\n    code\n    name\n    capital\n    currency\n    phone\n  }\n}",
            "variables": ""
          }
        },
        "url": {
          "raw": "https://countries.trevorblades.com/graphql",
          "protocol": "https",
          "host": [
            "countries",
            "trevorblades",
            "com"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },
