    {
      "name": "Query - Continent with Nested Countries (Nested Query)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Continent is South America\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.continent.name).to.eql(\"South America\");",
              "});",
              "pm.test(\"Continent has nested countries\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.continent.countries).to.be.an(\"array\");",
              "    pm.expect(jsonData.data.continent.countries.length).to.be.greaterThan(0);",
              "});",
              "pm.test(\"Countries have nested languages\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.data.continent.countries.forEach(function(country) {",
              "        pm.expect(country).to.have.property(\"languages\");",
              "    });",
              "});",
              "pm.test(\"No GraphQL errors\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.not.have.property(\"errors\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetContinentWithCountries {\n  continent(code: \"SA\") {\n    name\n    countries {\n      name\n      capital\n      currency\n      languages {\n        name\n        native\n      }\n    }\n  }\n}",
            "variables": ""
          }
        },
